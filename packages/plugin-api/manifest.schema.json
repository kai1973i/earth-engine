{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terrascope.dev/schemas/plugin-manifest.json",
  "title": "TerraScope plugin manifest",
  "type": "object",
  "required": ["id", "name", "version", "author", "license", "coreApi", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "Reverse-DNS plugin id, unique per installation."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+].*)?$" },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "coreApi": { "type": "string", "minLength": 1, "description": "SemVer range, e.g. ^0.1.0" },
    "description": { "type": "string", "maxLength": 500 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["layers", "tools", "ui", "analysis", "network"] }
    },
    "network": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
      "description": "Exact hostnames the plugin may contact."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "icon": { "type": "string", "description": "Lucide icon name, e.g. map" },
    "settingsSchema": { "type": "object" },
    "entry": { "type": "string", "description": "Entry module for locally loaded plugins" }
  }
}
